#version 450

#include "tiling_noise.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 1, binding = 0, rgba8) uniform writeonly image3D target;

// Worley fbm at three frequencies for wispy edges.
void main() {

    ivec3 size = imageSize(target);
    ivec3 texel = ivec3(gl_GlobalInvocationID);

    if (any(greaterThanEqual(texel, size))) {

        return;

    }

    vec3 uvw = (vec3(texel) + 0.5) / vec3(size);

    imageStore(target, texel, vec4(WorleyFbm(uvw, 2), WorleyFbm(uvw, 4), WorleyFbm(uvw, 8), 1.0));

}
