#version 450

#include "common.glsl"
#include "tiling_noise.glsl"
#include "volumetric.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 1, binding = 4, rgba16f) uniform writeonly image2D volumeColor;
layout(set = 1, binding = 5, r32f) uniform writeonly image2D volumeDepth;
layout(set = 1, binding = 6, r32f) uniform writeonly image2D volumeDistance;

// x: this frame's jitter offset, so successive frames sample between each other's steps.
layout(push_constant) uniform Push {

    vec4 params;

} pc;

const int MaxSegments = 8;

// Half resolution: each invocation marches the view ray of the top-left pixel of its 2x2 block, in front-to-back order of primitives.
void main() {

    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    if (any(greaterThanEqual(pixel, imageSize(volumeColor)))) {

        return;

    }

    ivec2 full = min(pixel * 2, ivec2(frame.viewport.xy) - 1);
    float depth = texelFetch(sceneDepth, full, 0).r;

    imageStore(volumeDepth, pixel, vec4(depth));

    int count = min(volumes.count.x, volumes.items.length());

    if (count == 0) {

        imageStore(volumeColor, pixel, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(volumeDistance, pixel, vec4(1e30));

        return;

    }

    vec2 ndc = (vec2(full) + 0.5) * frame.viewport.zw * 2.0 - 1.0;
    vec3 view = vec3(ndc.x / frame.projection[0][0], ndc.y / frame.projection[1][1], -1.0);
    vec3 direction = normalize(transpose(mat3(frame.view)) * view);
    vec3 origin = frame.cameraPosition.xyz;

    // Infinite reverse-Z: depth is near / view distance; sky pixels have no limit.
    float sceneDistance = depth > 0.0 ? frame.projection[3][2] / depth * length(view) : 1e30;

    int order[MaxSegments];
    float enters[MaxSegments];
    float exits[MaxSegments];
    int segments = 0;

    for (int i = 0; i < count && segments < MaxSegments; i++) {

        float enter;
        float exit;

        if (!VolumeSegment(volumes.items[i], origin, direction, enter, exit)) {

            continue;

        }

        exit = min(exit, sceneDistance);

        if (exit <= enter) {

            continue;

        }

        int slot = segments++;

        while (slot > 0 && enters[slot - 1] > enter) {

            order[slot] = order[slot - 1];
            enters[slot] = enters[slot - 1];
            exits[slot] = exits[slot - 1];
            slot--;

        }

        order[slot] = i;
        enters[slot] = enter;
        exits[slot] = exit;

    }

    VolumeResult result;

    result.luminance = vec3(0.0);
    result.transmittance = 1.0;
    result.depth = 0.0;

    float jitter = fract(52.9829189 * fract(dot(vec2(pixel), vec2(0.06711056, 0.00583715))) + pc.params.x);

    for (int s = 0; s < segments && result.transmittance > 0.005; s++) {

        MarchVolume(volumes.items[order[s]], origin, direction, enters[s], exits[s], jitter, result);

    }

    vec3 luminance = result.luminance;
    float opacity = 1.0 - result.transmittance;

    // Air between the camera and the volume dims its light and adds its own in place of what the volume hides.
    if (opacity > 0.0) {

        vec3 position = origin + direction * (result.depth / opacity);
        vec2 fragCoord = vec2(full) + 0.5;

        luminance = ApplyAerialPerspective(luminance, position, fragCoord) - ApplyAerialPerspective(vec3(0.0), position, fragCoord) * result.transmittance;

    }

    imageStore(volumeColor, pixel, vec4(min(luminance * frame.exposure.x, vec3(64000.0)), result.transmittance));

    // Where the volume mostly is along the ray, so history can be reprojected from there; the scene behind when it is empty.
    imageStore(volumeDistance, pixel, vec4(opacity > 0.01 ? result.depth / opacity : min(sceneDistance, 1e30)));

}
