#version 450

#include "tiling_noise.glsl"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 1, binding = 0, rgba8) uniform writeonly image3D target;

// r: Perlin-Worley billows; g, b, a: Worley fbm at rising frequencies for eroding them.
void main() {

    ivec3 size = imageSize(target);
    ivec3 texel = ivec3(gl_GlobalInvocationID);

    if (any(greaterThanEqual(texel, size))) {

        return;

    }

    vec3 uvw = (vec3(texel) + 0.5) / vec3(size);

    float perlin = PerlinFbm(uvw, 4);
    float worley = WorleyFbm(uvw, 4);
    float perlinWorley = clamp(Remap(perlin, worley - 1.0, 1.0, 0.0, 1.0), 0.0, 1.0);

    imageStore(target, texel, vec4(perlinWorley, worley, WorleyFbm(uvw, 8), WorleyFbm(uvw, 16)));

}
