#version 450

#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D target;

// Sky irradiance on a horizontal surface, per unit sun illuminance, over altitude and sun zenith.
void main() {

    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    if (any(greaterThanEqual(pixel, ivec2(IrradianceLutSize)))) {

        return;

    }

    vec2 uv = clamp(vec2(SubUvToUnit((pixel.x + 0.5) / IrradianceLutSize.x, IrradianceLutSize.x), SubUvToUnit((pixel.y + 0.5) / IrradianceLutSize.y, IrradianceLutSize.y)), 0.0, 1.0);

    float sunCos = uv.x * 2.0 - 1.0;
    float radius = BottomRadius() + 1.0 + uv.y * (TopRadius() - BottomRadius() - 2.0);

    vec3 origin = vec3(0.0, 0.0, radius);
    vec3 sunDirection = vec3(0.0, sqrt(max(1.0 - sunCos * sunCos, 0.0)), sunCos);
    vec3 irradiance = vec3(0.0);

    // Uniform in cosine of zenith, so every sample covers the same solid angle.
    for (int i = 0; i < 8; i++) {

        float cosZenith = (float(i) + 0.5) / 8.0;
        float sinZenith = sqrt(1.0 - cosZenith * cosZenith);

        for (int j = 0; j < 8; j++) {

            float azimuth = 2.0 * PI * (float(j) + 0.5) / 8.0;
            vec3 direction = vec3(sinZenith * cos(azimuth), sinZenith * sin(azimuth), cosZenith);

            irradiance += IntegrateScattering(origin, direction, sunDirection, 16, 1e12).luminance * cosZenith;

        }

    }

    imageStore(target, pixel, vec4(irradiance * (2.0 * PI / 64.0), 1.0));

}
