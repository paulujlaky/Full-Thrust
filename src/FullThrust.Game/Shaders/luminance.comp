#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D hdr;

layout(std430, set = 0, binding = 1) writeonly buffer Sums {

    vec2 groups[];

} sums;

// x, y: image size; z: 1 / exposure used for the image.
layout(push_constant) uniform Push {

    vec4 params;

} pc;

shared vec2 partial[256];

// Each workgroup covers 64x64 pixels, one sample per 4x4 block, and writes its sum of log2 luminance and weight.
void main() {

    ivec2 size = ivec2(pc.params.xy);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy) * 4 + 1;
    uint index = gl_LocalInvocationIndex;

    vec2 value = vec2(0.0);

    if (all(lessThan(pixel, size))) {

        vec3 color = texelFetch(hdr, pixel, 0).rgb * pc.params.z;
        float luminance = dot(color, vec3(0.2126, 0.7152, 0.0722));

        // The centre of the frame counts more, as a photographer's metering would.
        vec2 centred = (vec2(pixel) / vec2(size) - 0.5) * 2.0;
        float weight = 1.0 - 0.6 * min(dot(centred, centred), 1.0);

        value = vec2(log2(max(luminance, 1e-4)) * weight, weight);

    }

    partial[index] = value;

    barrier();

    for (uint stride = 128u; stride > 0u; stride >>= 1u) {

        if (index < stride) {

            partial[index] += partial[index + stride];

        }

        barrier();

    }

    if (index == 0u) {

        sums.groups[gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x] = partial[0];

    }

}
