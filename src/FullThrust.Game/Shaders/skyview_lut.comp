#version 450

#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D target;

// Sky luminance per unit sun illuminance around the camera, recomputed every frame.
void main() {

    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);

    if (any(greaterThanEqual(pixel, ivec2(SkyViewLutSize)))) {

        return;

    }

    vec3 camera = PlanetRelative(frame.cameraPosition.xyz);
    float viewHeight = max(length(camera), BottomRadius() + 1.0);
    float sunCos = dot(camera / length(camera), frame.sunDirection.xyz);

    vec2 uv = vec2(SubUvToUnit((pixel.x + 0.5) / SkyViewLutSize.x, SkyViewLutSize.x), SubUvToUnit((pixel.y + 0.5) / SkyViewLutSize.y, SkyViewLutSize.y));

    float viewZenithCos;
    float lightViewCos;

    SkyViewParams(clamp(uv, 0.0, 1.0), viewHeight, viewZenithCos, lightViewCos);

    vec3 origin = vec3(0.0, 0.0, viewHeight);
    vec3 sunDirection = vec3(sqrt(max(1.0 - sunCos * sunCos, 0.0)), 0.0, sunCos);

    float viewSin = sqrt(max(1.0 - viewZenithCos * viewZenithCos, 0.0));
    float lightViewSin = sqrt(max(1.0 - lightViewCos * lightViewCos, 0.0));
    vec3 direction = vec3(viewSin * lightViewCos, viewSin * lightViewSin, viewZenithCos);

    imageStore(target, pixel, vec4(IntegrateScattering(origin, direction, sunDirection, 30, 1e12).luminance, 1.0));

}
