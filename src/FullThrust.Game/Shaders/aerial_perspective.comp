#version 450

#include "common.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 1, binding = 0, rgba16f) uniform writeonly image3D target;
layout(set = 1, binding = 1, rgba16f) uniform writeonly image2D shafts;

const int StepsPerSlice = 2;

// Far slices step further than cloud shadows are wide, so their shadow fades out rather than aliasing.
const float ShadowFadeStart = 40000.0;
const float ShadowFadeEnd = 120000.0;

// One thread per screen column marches its view ray once, storing in-scattering and mean transmittance at each slice end.
void main() {

    ivec3 size = imageSize(target);
    ivec2 column = ivec2(gl_GlobalInvocationID.xy);

    if (any(greaterThanEqual(column, size.xy))) {

        return;

    }

    vec2 ndc = (vec2(column) + 0.5) / vec2(size.xy) * 2.0 - 1.0;
    vec3 direction = ViewDirection(ndc);
    vec3 origin = PlanetRelative(frame.cameraPosition.xyz);
    vec3 sunDirection = frame.sunDirection.xyz;

    float near;
    float far;
    bool inside = RaySphere(origin, direction, TopRadius(), near, far) && far > 0.0;

    float enter = max(near, 0.0);

    // Past the ground the integral holds its value, so surfaces between two slices interpolate towards their own depth.
    float groundNear;
    float groundFar;

    if (RaySphere(origin, direction, BottomRadius(), groundNear, groundFar) && groundNear > 0.0) {

        far = min(far, groundNear);

    }

    float maxDistance = frame.aerialPerspective.x;

    float cosTheta = dot(direction, sunDirection);
    float rayleighPhase = RayleighPhase(cosTheta);
    float miePhase = MiePhase(cosTheta);

    ScatteringResult result;

    result.luminance = vec3(0.0);
    result.transmittance = vec3(1.0);

    vec3 lost = vec3(0.0);
    float start = 0.0;

    for (int k = 0; k < size.z; k++) {

        float s = float(k + 1) / float(size.z);
        float end = maxDistance * s * s;

        float a = max(start, enter);
        float b = min(end, far);

        if (inside && b > a) {

            float dt = (b - a) / float(StepsPerSlice);

            for (int i = 0; i < StepsPerSlice; i++) {

                float t = a + (float(i) + 0.5) * dt;
                vec3 p = origin + direction * t;
                float visibility = mix(CloudShadow(p + frame.atmosphereCenter.xyz), 1.0, smoothstep(ShadowFadeStart, ShadowFadeEnd, t)) * dot(EclipseLight(p + frame.atmosphereCenter.xyz), vec3(1.0 / 3.0));

                ShadowedScatterStep(p, dt, sunDirection, rayleighPhase, miePhase, visibility, result, lost);

            }

        }

        imageStore(target, ivec3(column, k), vec4(result.luminance, dot(result.transmittance, vec3(1.0 / 3.0))));

        start = end;

    }

    // The sky-view table knows nothing of clouds, so the sky subtracts what their shadows took from this column.
    imageStore(shafts, column, vec4(lost, 0.0));

}
