<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ahwoo.Brutal.Glfw" />
    <PackageReference Include="Ahwoo.Brutal.Vulkan" />
    <PackageReference Include="Ahwoo.Brutal.Vulkan.Abstractions" />
    <PackageReference Include="Ahwoo.Brutal.ImGui" />
    <PackageReference Include="Ahwoo.Brutal.ImGui.Backends" />
    <PackageReference Include="Ahwoo.Brutal.ImGui.Extensions" />
    <PackageReference Include="Ahwoo.Brutal.ShaderC" />
    <PackageReference Include="Ahwoo.Brutal.Stb" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Shaders\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\data\**\*" Link="data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FullThrust.Assets\FullThrust.Assets.csproj" />
    <ProjectReference Include="..\FullThrust.Core\FullThrust.Core.csproj" />
    <ProjectReference Include="..\FullThrust.Physics.Jolt\FullThrust.Physics.Jolt.csproj" />
  </ItemGroup>

